{
  "name": "web",
  "version": "2.0.0-alpha.7",
  "type": "module",
  "scripts": {
    "check": "check",
    "dev": "bun --silent aframe",
    "build": "bun --silent aframe build",
    "preview": "bun --cwd .output --env-file ../.env server-entry.js",
    "docker:build": "bun run build && docker build -t anime-skip/web:latest .",
    "docker:preview": "docker run --init --rm -p 3000:3000 -e NODE_ENV=production --env-file=.env anime-skip/web:latest",
    "gen": "bun gen:db && bun gen:graphql",
    "gen:db": "bun run drizzle-kit generate",
    "gen:graphql": "bun scripts/graphql-codegen.ts"
  },
  "dependencies": {
    "@aklinker1/aframe": "^2.0.4",
