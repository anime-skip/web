{
  "name": "web",
  "packageManager": "bun@1.2.3",
  "type": "module",
  "scripts": {
    "check": "check",
    "dev": "bun --silent aframe",
    "build": "bun --silent aframe build",
    "preview": "bun --cwd .output --env-file ../.env server-entry.js",
    "docker:build": "docker build -t web:latest .",
    "docker:preview": "docker run --init --rm -p 3000:3000 -e NODE_ENV=production --env-file=.env web:latest",
    "gen": "bun gen:db && bun gen:graphql",
    "gen:db": "bun run drizzle-kit generate",
    "gen:graphql": "bun scripts/graphql-codegen.ts",
    "aframe": "bun run node_modules/@aklinker1/aframe/bin/aframe"
  },
  "dependencies": {
    "@aklinker1/aframe": "^0.2.5",
    "@aklinker1/zero-ioc": "^1.3.1",
    "@elysiajs/swagger": "^1.2.2",
    "@graphql-tools/schema": "^10.0.16",
    "@graphql-tools/utils": "^10.7.2",
    "@iconify-json/heroicons": "^1.2.2",
    "@types/nodemailer": "^6.4.17",
    "@vueuse/core": "^12.5.0",
    "bcryptjs": "^2.4.3",
    "dataloader": "^2.2.3",
    "drizzle-orm": "^0.38.4",
    "elysia": "^1.2.21",
    "es-toolkit": "^1.31.0",
    "fs-extra": "^11.3.0",
    "graphql": "^16.10.0",
    "graphql-tag": "^2.12.6",
    "jose": "^5.9.6",
    "md5": "^2.3.0",
    "mime": "^4.0.6",
    "nanoid": "^5.0.9",
    "nodemailer": "^6.10.0",
    "pg": "^8.13.1",
    "reka-ui": "^1.0.0-alpha.8",
    "serialize-error": "^12.0.0",
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@aklinker1/check": "^1.4.5",
    "@egoist/tailwindcss-icons": "^1.9.0",
    "@graphql-codegen/core": "^4.0.2",
    "@graphql-codegen/plugin-helpers": "^5.1.0",
    "@graphql-codegen/typescript": "^4.1.2",
    "@graphql-codegen/typescript-operations": "^4.4.0",
    "@graphql-codegen/typescript-resolvers": "^4.4.1",
    "@prerenderer/prerenderer": "^1.2.5",
    "@prerenderer/renderer-puppeteer": "^1.2.4",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "latest",
    "@types/fs-extra": "^11.0.4",
    "@types/md5": "^2.3.5",
    "@types/pg": "^8.11.11",
    "@vitejs/plugin-vue": "^5.2.1",
    "consola": "^3.4.0",
    "drizzle-kit": "^0.30.2",
    "oxlint": "^0.15.8",
    "prettier": "^3.4.2",
    "puppeteer": "^24.2.1",
    "typescript": "^5.0.0",
    "vite": "^6.0.11",
    "vite-plugin-compression2": "^1.3.3",
    "vue-tsc": "^2.2.0"
  }
}
