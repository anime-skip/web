{
  "name": "web",
  "packageManager": "bun@1.3.6",
  "type": "module",
  "scripts": {
    "check": "check",
    "dev": "bun --silent aframe",
    "build": "bun --silent aframe build",
    "preview": "bun --cwd .output --env-file ../.env server-entry.js",
    "docker:build": "docker build -t web:latest .",
    "docker:preview": "docker run --init --rm -p 3000:3000 -e NODE_ENV=production --env-file=.env web:latest",
    "gen": "bun gen:db && bun gen:graphql",
    "gen:db": "bun run drizzle-kit generate",
    "gen:graphql": "bun scripts/graphql-codegen.ts",
    "aframe": "bun run node_modules/@aklinker1/aframe/bin/aframe"
  },
  "dependencies": {
    "@aklinker1/aframe": "^0.5.0",
    "@aklinker1/zero-ioc": "^1.3.4",
    "@aklinker1/zeta": "^1.3.3",
    "@elysiajs/swagger": "^1.3.1",
    "@graphql-tools/schema": "^10.0.25",
    "@graphql-tools/utils": "^10.9.1",
    "@iconify-json/heroicons": "^1.2.2",
    "@iconify-json/logos": "^1.2.5",
    "@tanstack/vue-query": "^5.83.0",
    "@types/nodemailer": "^6.4.17",
    "@unhead/vue": "^2.0.12",
    "@vueuse/core": "^13.5.0",
    "bcryptjs": "^3.0.2",
    "dataloader": "^2.2.3",
    "dedent": "^1.7.0",
    "drizzle-orm": "^0.45.1",
    "elysia": "^1.3.6",
    "es-toolkit": "^1.39.8",
    "fs-extra": "^11.3.0",
    "graphql": "^16.11.0",
    "graphql-tag": "^2.12.6",
    "jose": "^6.0.12",
    "md5": "^2.3.0",
    "mime": "^4.0.7",
    "nanoid": "^5.1.5",
    "nodemailer": "^7.0.5",
    "pg": "^8.16.3",
    "reka-ui": "^2.4.0",
    "serialize-error": "^12.0.0",
    "tailwindcss": "^4.1.11",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@aklinker1/check": "^2.2.0",
    "@egoist/tailwindcss-icons": "^1.9.0",
    "@graphql-codegen/core": "^4.0.2",
    "@graphql-codegen/plugin-helpers": "^5.1.1",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@graphql-codegen/typescript-resolvers": "^4.5.1",
    "@prerenderer/prerenderer": "^1.2.5",
    "@prerenderer/renderer-puppeteer": "^1.2.4",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.11",
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "^1.2.19",
    "@types/fs-extra": "^11.0.4",
    "@types/md5": "^2.3.5",
    "@types/pg": "^8.15.4",
    "@vitejs/plugin-vue": "^6.0.0",
    "consola": "^3.4.2",
    "drizzle-kit": "^0.31.8",
    "oxlint": "^1.8.0",
    "prettier": "^3.6.2",
    "puppeteer": "^24.15.0",
    "typescript": "^5.8.3",
    "unplugin-vue-markdown": "^29.1.0",
    "vite": "^7.0.6",
    "vue-tsc": "^3.0.4"
  }
}
